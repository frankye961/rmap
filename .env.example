# Optional DeepSeek API base URL override; blank uses Rig's default.
RMAP_AI_BASE_URL=
# DeepSeek authentication credential.
RMAP_AI_API_KEY=
# DeepSeek model identifier chosen by the user.
RMAP_AI_MODEL=
# Maximum duration of an AI request, in milliseconds.
RMAP_AI_TIMEOUT_MS=15000
# Optional path to a UTF-8, tab-separated local CVE advisory file.
RMAP_CVE_FILE=
