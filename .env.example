# Optional DeepSeek API base URL override; blank uses Rig's default.
RMAP_AI_BASE_URL=
# DeepSeek authentication credential.
RMAP_AI_API_KEY=
# DeepSeek model identifier chosen by the user.
RMAP_AI_MODEL=
# Maximum duration of the complete AI research session, in milliseconds.
RMAP_AI_TIMEOUT_MS=60000
# Optional path to a UTF-8, tab-separated local CVE advisory file.
RMAP_CVE_FILE=

# Brave Search API key for live public CVE and Exploit-DB research.
# Separate from the DeepSeek API key; leave blank for interpretation without web search.
RMAP_SEARCH_API_KEY=
